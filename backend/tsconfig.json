{
  "compilerOptions": {
    "target": "ES2022",
    // DOM: definisi lengkap Request/Response/AbortSignal. @types/node mengosongkan
    // tipe web-nya bila lingkungan build memuat tipe browser (terjadi di build
    // Vercel), sehingga tanpa DOM properti seperti `signal`/`status` tidak dikenal.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "supabase/**/*.ts", "vitest.config.ts"]
}
