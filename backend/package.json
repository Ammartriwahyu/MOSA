{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "push:keys": "tsx scripts/generate-push-keys.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/local-server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "bench:local": "tsx tests/performance/benchmark-local.ts",
    "dose:check-utc": "tsx scripts/check-dose-timezone.ts",
    "ai:try-explainer": "tsx --env-file-if-exists=.env scripts/try-explainer.ts",
    "db:check-rls": "tsx --env-file-if-exists=../frontend/.env.local scripts/check-rls.ts",
    "seed:demo": "tsx --env-file-if-exists=.env supabase/seed/demo.ts",
    "seed:demo-due": "tsx --env-file-if-exists=.env supabase/seed/demo.ts --due",
    "db:types": "npx -y supabase@3.1.0 gen types typescript --schema public > src/shared/infrastructure/database.types.ts"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "@hono/node-server": "2.1.6",
    "@supabase/supabase-js": "2.119.0",
    "hono": "4.13.17",
    "web-push": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@eslint/js": "^10.0.1",
    "@types/node": "24.19.2",
    "@types/web-push": "3.6.4",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.2",
    "globals": "^17.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
