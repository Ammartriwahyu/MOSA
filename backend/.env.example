# Salin menjadi backend/.env lalu isi. Jangan pernah meng-commit .env.
# Konfigurasi backend. Secret key Supabase, kunci Gemini dan rahasia HMAC hanya di server.

# Lokal: development. Vercel mengisi production sendiri.
NODE_ENV=development
# Port server lokal (pnpm dev).
PORT=8787
# Origin frontend yang boleh memanggil API (CORS). Wajib di produksi.
FRONTEND_ORIGIN=http://localhost:3000

# Supabase (Project Settings > API Keys). Pakai secret key (sb_secret_...),
# pengganti service_role. Kunci ini melewati RLS: hanya di backend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Gemini (Google AI Studio). Nama model diisi di sini, tidak ditulis di kode.
# Dibuat anggota tim berusia 18+ (PRD §12.3 #8). Model stabil yang dicek 11 Nov 2026:
# gemini-3.6-flash (lihat aistudio.google.com/docs/models dan /docs/deprecations).
GEMINI_API_KEY=
GEMINI_MODEL=
# Jatah panggilan AI per rumah tangga per hari (bawaan 20; sesuaikan dengan kuota di AI Studio).
AI_DAILY_LIMIT=20

# Rahasia HMAC token scan (✓✓), wajib acak minimal 32 karakter.
# Buat melalui pengelola rahasia dan isi langsung di environment; jangan masukkan ke log/git.
SCAN_TOKEN_SECRET=

# Akun Demo Juri (dipakai pnpm seed:demo). Email fiktif, kata sandi minimal 8 karakter.
DEMO_EMAIL=
DEMO_PASSWORD=
