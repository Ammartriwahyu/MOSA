# Salin menjadi backend/.env lalu isi. Jangan pernah meng-commit .env.
# Semua nilai di sini rahasia server; jangan dipakai di frontend.

# Lokal: development. Vercel mengisi production sendiri.
NODE_ENV=development
# Port server lokal (pnpm dev).
PORT=8787
# Origin frontend yang boleh memanggil API (CORS). Wajib di produksi.
FRONTEND_ORIGIN=http://localhost:3000

# Supabase (Project Settings > API Keys). Pakai secret key (sb_secret_...),
# pengganti service_role. Kunci ini melewati RLS: hanya di backend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Gemini (Google AI Studio). Nama model diisi di sini, tidak ditulis di kode.
GEMINI_API_KEY=
GEMINI_MODEL=

# Rahasia HMAC token scan (✓✓). Isi string acak panjang, mis. hasil:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SCAN_TOKEN_SECRET=

# Header x-cron-secret untuk endpoint cron (keep-alive dan pengingat). String acak panjang.
CRON_SECRET=

# Tahap 2 (Web Push): isi hanya bila fitur notifikasi dibangun.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
