# Salin menjadi frontend/.env.local lalu isi. Jangan pernah meng-commit .env*.
# Variabel NEXT_PUBLIC_ ikut terkirim ke browser: hanya nilai publik di sini.
# Kunci rahasia (secret key Supabase, Gemini) hanya ada di backend/.env.

# Alamat backend (lokal: pnpm dev di backend).
NEXT_PUBLIC_API_URL=http://localhost:8787

# Supabase Auth untuk login. Pakai publishable key (sb_publishable_...), pengganti anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opsional: hanya public key dari pasangan VAPID backend yang sama.
# Kosong = pengingat belum tersedia. Private key/CRON_SECRET tidak boleh masuk frontend.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
